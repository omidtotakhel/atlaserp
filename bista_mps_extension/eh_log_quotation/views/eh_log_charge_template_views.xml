<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>

        <record id="view_eh_log_charge_template_list" model="ir.ui.view">
            <field name="name">eh.log.charge.template.list</field>
            <field name="model">eh.log.charge.template</field>
            <field name="arch" type="xml">
                <tree string="Charge Templates">
                    <field name="code"/>
                    <field name="name"/>
                    <field name="mode"/>
                    <field name="direction"/>
                    <field name="origin_country_id" optional="show"/>
                    <field name="destination_country_id" optional="show"/>
                    <field name="line_count" optional="show"/>
                    <field name="default_currency_id" optional="hide" groups="base.group_multi_currency"/>
                    <field name="active" optional="hide"/>
                </tree>
            </field>
        </record>

        <record id="view_eh_log_charge_template_form" model="ir.ui.view">
            <field name="name">eh.log.charge.template.form</field>
            <field name="model">eh.log.charge.template</field>
            <field name="arch" type="xml">
                <form string="Charge Template">
                    <sheet>
                        <div class="oe_title">
                            <label for="code"/>
                            <h1>
                                <field name="code" placeholder="SEA-FCL-AE-SA-20"/>
                            </h1>
                            <field name="name" placeholder="Sea FCL Jebel Ali to Dammam, FCL 20'"/>
                        </div>
                        <group>
                            <group string="Lane">
                                <field name="mode" widget="radio" options="{'horizontal': true}"/>
                                <field name="direction" widget="radio" options="{'horizontal': true}"/>
                                <field name="origin_country_id" options="{'no_create': True}"/>
                                <field name="destination_country_id" options="{'no_create': True}"/>
                            </group>
                            <group string="Defaults">
                                <field name="default_currency_id" options="{'no_create': True}"/>
                                <field name="active" widget="boolean_toggle"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Lines">
                                <field name="line_ids">
                                    <tree editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="charge_code_id" options="{'no_create': True}"/>
                                        <field name="leg"/>
                                        <field name="default_quantity"/>
                                        <field name="default_unit_price"/>
                                        <field name="default_planned_cost"/>
                                        <field name="currency_id" optional="hide" groups="base.group_multi_currency"/>
                                        <field name="description" optional="hide"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Detail">
                                <field name="description"/>
                            </page>
                            <page string="Companies">
                                <field name="company_ids" widget="many2many_tags"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_eh_log_charge_template_search" model="ir.ui.view">
            <field name="name">eh.log.charge.template.search</field>
            <field name="model">eh.log.charge.template</field>
            <field name="arch" type="xml">
                <search>
                    <field name="code"/>
                    <field name="name"/>
                    <field name="origin_country_id"/>
                    <field name="destination_country_id"/>
                    <separator/>
                    <filter string="Active" name="filter_active" domain="[('active', '=', True)]"/>
                    <filter string="Group by Mode" name="group_mode" context="{'group_by': 'mode'}"/>
                    <filter string="Group by Direction" name="group_direction" context="{'group_by': 'direction'}"/>
                </search>
            </field>
        </record>

        <record id="action_eh_log_charge_template" model="ir.actions.act_window">
            <field name="name">Charge Templates</field>
            <field name="res_model">eh.log.charge.template</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_eh_log_charge_template_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Define re-usable charge bundles for your common lanes
                </p>
                <p>
                    A template carries the charge code, leg classification,
                    default quantity, and default unit price. Apply it to a
                    quotation in one click and the lines drop in.
                </p>
            </field>
        </record>

    </data>
</odoo>
