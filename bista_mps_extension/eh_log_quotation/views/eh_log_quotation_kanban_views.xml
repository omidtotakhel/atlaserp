<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_eh_log_sale_order_kanban" model="ir.ui.view">
        <field name="name">sale.order.kanban.eh_log_quotation</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="amount_total"/>
                <field name="currency_id"/>
                <field name="state"/>
                <field name="eh_log_mode"/>
                <field name="eh_log_direction"/>
                <field name="eh_log_margin_status"/>
                <field name="eh_log_credit_status"/>
                <field name="eh_log_kyc_status"/>
                <field name="eh_log_requires_approval"/>
                <field name="eh_log_gross_margin_pct"/>
                <field name="date_order"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title"><field name="name"/></strong>
                                    <span class="o_kanban_record_subtitle"><field name="partner_id"/></span>
                                </div>
                                <span t-if="record.eh_log_requires_approval.raw_value" class="badge text-bg-warning float-end">
                                    Approval Required
                                </span>
                            </div>
                            <div class="o_kanban_record_body mt-1">
                                <span t-if="record.eh_log_mode.raw_value" class="badge text-bg-secondary me-1">
                                    <field name="eh_log_mode"/>
                                </span>
                                <span t-if="record.eh_log_direction.raw_value" class="badge text-bg-secondary me-1">
                                    <field name="eh_log_direction"/>
                                </span>
                                <span t-if="record.eh_log_margin_status.raw_value == 'below_floor'" class="badge text-bg-danger me-1">
                                    Margin <field name="eh_log_gross_margin_pct" widget="percentage"/>
                                </span>
                                <span t-elif="record.eh_log_margin_status.raw_value == 'warning'" class="badge text-bg-warning me-1">
                                    Margin <field name="eh_log_gross_margin_pct" widget="percentage"/>
                                </span>
                                <span t-elif="record.eh_log_margin_status.raw_value == 'above_warning'" class="badge text-bg-success me-1">
                                    Margin <field name="eh_log_gross_margin_pct" widget="percentage"/>
                                </span>
                                <span t-if="record.eh_log_credit_status.raw_value == 'blocked'" class="badge text-bg-danger me-1">
                                    Credit Blocked
                                </span>
                                <span t-if="record.eh_log_kyc_status.raw_value == 'expired'" class="badge text-bg-danger me-1">
                                    KYC Expired
                                </span>
                            </div>
                            <div class="o_kanban_record_bottom mt-2">
                                <div class="oe_kanban_bottom_left">
                                    <field name="date_order" widget="date"/>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="amount_total" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

</odoo>
