<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>

        <record id="view_eh_log_quotation_preflight_form" model="ir.ui.view">
            <field name="name">eh.log.quotation.preflight.form</field>
            <field name="model">eh.log.quotation.preflight</field>
            <field name="arch" type="xml">
                <form string="Preflight Checklist">
                    <header>
                        <field name="overall_status" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>Preflight: <field name="order_id" readonly="1"/></h1>
                        </div>
                        <group>
                            <field name="summary" readonly="1" widget="text" colspan="2"/>
                        </group>
                        <field name="line_ids" readonly="1">
                            <tree create="false" edit="false" delete="false"
                                  decoration-success="status == 'ok'"
                                  decoration-warning="status == 'warning'"
                                  decoration-danger="status == 'blocked'"
                                  decoration-muted="status == 'not_applicable'">
                                <field name="check"/>
                                <field name="status"/>
                                <field name="message"/>
                                <field name="hint"/>
                            </tree>
                        </field>
                    </sheet>
                    <footer>
                        <button string="Close" name="action_close" type="object" class="btn-primary"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>
