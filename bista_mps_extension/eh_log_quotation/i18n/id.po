msgstr "Wisaya"

#. module: eh_log_quotation
#. odoo-python
#: code:addons/eh_log_quotation/models/sale_order.py:0
msgid ""
"[EHL-APPROVAL-001] Only logistics managers can approve this quotation. Ask "
"your manager to take action."
msgstr ""
"[EHL-APPROVAL-001] Hanya manajer logistik yang dapat menyetujui penawaran "
"ini. Minta manajer Anda untuk mengambil tindakan."

#. module: eh_log_quotation
#. odoo-python
#: code:addons/eh_log_quotation/models/sale_order.py:0
msgid ""
"[EHL-APPROVAL-002] This quotation does not currently require approval. The "
"Approve action is only available when the margin, credit, or KYC guard "
"surfaces a blocking reason."
msgstr ""
"[EHL-APPROVAL-002] Penawaran ini saat ini tidak memerlukan persetujuan. "
"Tindakan Setujui hanya tersedia ketika pengaman margin, kredit, atau KYC "
"menampilkan alasan pemblokiran."

#. module: eh_log_quotation
#. odoo-python
#: code:addons/eh_log_quotation/models/sale_order.py:0
#, python-format
msgid ""
"[EHL-APPROVAL-003] Quotation %(name)s requires manager approval before confirmation. Reasons:\n"
"%(reasons)s\n"
"\n"
"Use the Approve action to record the decision, then confirm again."
msgstr ""
"[EHL-APPROVAL-003] Penawaran %(name)s memerlukan persetujuan manajer sebelum konfirmasi. Alasan:\n"
"%(reasons)s\n"
"\n"
"Gunakan tindakan Setujui untuk mencatat keputusan, lalu konfirmasi lagi."

#. module: eh_log_quotation
#. odoo-python
#: code:addons/eh_log_quotation/wizards/eh_log_mass_action_wizards.py:0
msgid "[EHL-APPROVAL-010] Only logistics managers may run mass-approve."
msgstr ""
"[EHL-APPROVAL-010] Hanya manajer logistik yang dapat menjalankan persetujuan"
" massal."

#. module: eh_log_quotation
#. odoo-python
#: code:addons/eh_log_quotation/wizards/eh_log_charge_template_apply.py:0
#, python-format
msgid ""
"[EHL-TEMPLATE-001] Template %(name)s has no lines. Add lines to the template"
" first."
msgstr ""
"[EHL-TEMPLATE-001] Templat %(name)s tidak memiliki baris. Tambahkan baris ke"
" templat terlebih dahulu."
