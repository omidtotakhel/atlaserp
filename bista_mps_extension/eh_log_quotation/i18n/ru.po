#: model_terms:ir.ui.view,arch_db:eh_log_quotation.view_eh_log_quotation_mass_send_review_form
msgid "Send for Review"
msgstr "Отправить на проверку"

#. module: eh_log_quotation
#: model:ir.model.fields,field_description:eh_log_quotation.field_eh_log_charge_template_line__sequence
#: model:ir.model.fields,field_description:eh_log_quotation.field_eh_log_quotation_preflight_line__sequence
msgid "Sequence"
msgstr "Последовательность"

#. module: eh_log_quotation
#. odoo-python
#: code:addons/eh_log_quotation/wizards/eh_log_quotation_preflight.py:0
msgid "Set the destination country on the Logistics tab."
msgstr "Укажите страну назначения на вкладке Logistics."

#. module: eh_log_quotation
#. odoo-python
#: code:addons/eh_log_quotation/wizards/eh_log_quotation_preflight.py:0
msgid "Set the origin country on the Logistics tab."
msgstr "Укажите страну происхождения на вкладке Logistics."

#. module: eh_log_quotation
#. odoo-python
#: code:addons/eh_log_quotation/wizards/eh_log_quotation_preflight.py:0
msgid ""
"Some checks raised warnings. The order can be confirmed but review the "
"warnings first."
msgstr ""
"Некоторые проверки вызвали предупреждения. Заказ можно подтвердить, но "
"сначала просмотрите предупреждения."

#. module: eh_log_quotation
#: model:ir.model.fields,help:eh_log_quotation.field_sale_order__eh_log_destination_location
msgid "Specific port, airport, or delivery point."
msgstr "Конкретный порт, аэропорт или пункт доставки."

#. module: eh_log_quotation
#: model:ir.model.fields,help:eh_log_quotation.field_sale_order__eh_log_origin_location
msgid ""
"Specific port, airport, or pickup point. Free text at this layer; the "
"freight forwarding module replaces with structured port and airport master "
"data."
msgstr ""
"Конкретный порт, аэропорт или пункт получения. На этом уровне произвольный "
"текст; модуль экспедирования грузов заменяет его структурированными "
"основными данными портов и аэропортов."

#. module: eh_log_quotation
#: model:ir.model.fields,help:eh_log_quotation.field_eh_log_charge_template__code
msgid ""
"Stable short identifier (e.g. SEA-FCL-AE-SA-20). Used to recall the template"
" by typed search rather than by scrolling the dropdown."
msgstr ""
"Стабильный короткий идентификатор (например, SEA-FCL-AE-SA-20). Используется"
" для вызова шаблона через ввод в поиске, а не прокрутку выпадающего списка."

#. module: eh_log_quotation
#: model:ir.model.fields,help:eh_log_quotation.field_sale_order_line__eh_log_charge_code_id
msgid ""
"Standardised charge code for this line. Drives the leg classification, the "
"tax tag default, and whether the line is included in the margin computation."
msgstr ""
"Стандартизированный код сбора для этой строки. Определяет классификацию "
"плеча, значение по умолчанию для налоговой метки и включается ли строка в "
"расчёт маржи."

#. module: eh_log_quotation
#: model:ir.model.fields,help:eh_log_quotation.field_eh_log_charge_template_line__charge_code_id
msgid ""
"Standardised charge code from the ERP Heritage catalogue. The Apply Template"
" wizard creates a sale order line carrying this code so reports and the "
"margin guard work."
msgstr ""
"Стандартизированный код сбора из каталога ERP Heritage. Мастер применения "
"шаблона создаёт строку заказа на продажу с этим кодом, чтобы отчёты и защита"
" маржи работали."

#. module: eh_log_quotation
#: model:ir.model.fields,field_description:eh_log_quotation.field_eh_log_quotation_preflight_line__status
msgid "Status"
msgstr "Статус"

#. module: eh_log_quotation
#: model:ir.model.fields,field_description:eh_log_quotation.field_eh_log_quotation_preflight_line__hint
msgid "Suggested Action"
msgstr "Предлагаемое действие"

#. module: eh_log_quotation
#: model:ir.model.fields,help:eh_log_quotation.field_sale_order__eh_log_total_planned_cost
msgid "Sum of planned cost across non-disbursement lines."
msgstr "Сумма плановых затрат по строкам, не связанным с расходами."

#. module: eh_log_quotation
#: model:ir.model.fields,help:eh_log_quotation.field_sale_order__eh_log_total_revenue_billable
msgid ""
"Sum of revenue across non-disbursement lines. Disbursements are excluded "
"from margin computation."
msgstr ""
"Сумма доходов по строкам, не связанным с расходами. Расходы исключаются из "
"расчёта маржи."

#. module: eh_log_quotation
#: model:ir.model.fields,help:eh_log_quotation.field_sale_order__eh_log_credit_exposure
msgid ""
"Sum of the partner's currently outstanding receivables in the company "
"currency. Recomputed on every read."
msgstr ""
"Сумма текущей непогашенной дебиторской задолженности партнёра в валюте "
"компании. Пересчитывается при каждом чтении."

#. module: eh_log_quotation
#: model:ir.model.fields,field_description:eh_log_quotation.field_eh_log_quotation_preflight__summary
msgid "Summary"
msgstr "Резюме"

#. module: eh_log_quotation
#: model:ir.model.fields,field_description:eh_log_quotation.field_eh_log_charge_template_apply__template_id
#: model:ir.model.fields,field_description:eh_log_quotation.field_eh_log_charge_template_line__template_id
#: model_terms:ir.ui.view,arch_db:eh_log_quotation.view_sale_order_form_eh_log
msgid "Template"
msgstr "Шаблон"

#. module: eh_log_quotation
#: model_terms:ir.ui.view,arch_db:eh_log_quotation.view_sale_order_form_eh_log
msgid "This is a logistics order"
msgstr "Это логистический заказ"

#. module: eh_log_quotation
#. odoo-python
#: code:addons/eh_log_quotation/models/sale_order.py:0
msgid ""
"This quotation has logistics charge codes on its lines. Disabling the "
"logistics flag will skip the credit / KYC / margin guards on confirmation."
msgstr ""
"В строках этого коммерческого предложения есть коды логистических сборов. "
"Отключение флага логистики приведёт к пропуску проверок кредита / KYC / "
"маржи при подтверждении."

#. module: eh_log_quotation
#: model:ir.model.fields,field_description:eh_log_quotation.field_sale_order__eh_log_total_planned_cost
msgid "Total Planned Cost"
msgstr "Итого плановая стоимость"

#. module: eh_log_quotation
#. odoo-python
#: code:addons/eh_log_quotation/wizards/eh_log_quotation_preflight.py:0
msgid "Upload current KYC documents before confirming."
msgstr "Загрузите текущие документы KYC перед подтверждением."

#. module: eh_log_quotation
#: model:ir.model.fields.selection,name:eh_log_quotation.selection__eh_log_quotation_preflight__overall_status__warning
#: model:ir.model.fields.selection,name:eh_log_quotation.selection__eh_log_quotation_preflight_line__status__warning
#: model:ir.model.fields.selection,name:eh_log_quotation.selection__sale_order__eh_log_credit_status__warning
#: model:ir.model.fields.selection,name:eh_log_quotation.selection__sale_order__eh_log_kyc_status__warning
#: model:ir.model.fields.selection,name:eh_log_quotation.selection__sale_order__eh_log_margin_status__warning
msgid "Warning"
msgstr "Предупреждение"

#. module: eh_log_quotation
#: model:ir.model.fields,help:eh_log_quotation.field_sale_order_line__eh_log_is_disbursement
msgid ""
"When True, the line is treated as pass-through and excluded from gross "
"margin computation."
msgstr ""
"При значении True строка рассматривается как транзитная и исключается из "
"расчёта валовой маржи."

#. module: eh_log_quotation
#: model:ir.model.fields,help:eh_log_quotation.field_eh_log_charge_template_apply__replace_existing
msgid ""
"When checked, existing logistics charge lines (lines carrying a charge code)"
" are removed before the template lines are appended. Non-logistics product "
"lines are always preserved."
msgstr ""
"При установке флажка существующие строки логистических сборов (строки с "
"кодом сбора) удаляются перед добавлением строк шаблона. Строки "
"нелогистических товаров всегда сохраняются."

#. module: eh_log_quotation
#: model:ir.model.fields,field_description:eh_log_quotation.field_eh_log_quotation_preflight_line__wizard_id
msgid "Wizard"
msgstr "Мастер"

#. module: eh_log_quotation
#. odoo-python
#: code:addons/eh_log_quotation/models/sale_order.py:0
msgid ""
"[EHL-APPROVAL-001] Only logistics managers can approve this quotation. Ask "
"your manager to take action."
msgstr ""
"[EHL-APPROVAL-001] Утвердить это коммерческое предложение могут только "
"менеджеры по логистике. Попросите своего руководителя принять меры."

#. module: eh_log_quotation
#. odoo-python
#: code:addons/eh_log_quotation/models/sale_order.py:0
msgid ""
"[EHL-APPROVAL-002] This quotation does not currently require approval. The "
"Approve action is only available when the margin, credit, or KYC guard "
"surfaces a blocking reason."
msgstr ""
"[EHL-APPROVAL-002] Это коммерческое предложение в настоящее время не требует"
" утверждения. Действие «Утвердить» доступно только тогда, когда контроль "
"маржи, кредита или KYC выявляет блокирующую причину."

#. module: eh_log_quotation
#. odoo-python
#: code:addons/eh_log_quotation/models/sale_order.py:0
#, python-format
msgid ""
"[EHL-APPROVAL-003] Quotation %(name)s requires manager approval before confirmation. Reasons:\n"
"%(reasons)s\n"
"\n"
"Use the Approve action to record the decision, then confirm again."
msgstr ""
"[EHL-APPROVAL-003] Коммерческое предложение %(name)s требует утверждения руководителем перед подтверждением. Причины:\n"
"%(reasons)s\n"
"\n"
"Используйте действие «Утвердить», чтобы зафиксировать решение, затем подтвердите снова."

#. module: eh_log_quotation
#. odoo-python
#: code:addons/eh_log_quotation/wizards/eh_log_mass_action_wizards.py:0
msgid "[EHL-APPROVAL-010] Only logistics managers may run mass-approve."
msgstr ""
"[EHL-APPROVAL-010] Массовое утверждение могут выполнять только менеджеры по "
"логистике."

#. module: eh_log_quotation
#. odoo-python
#: code:addons/eh_log_quotation/wizards/eh_log_charge_template_apply.py:0
#, python-format
msgid ""
"[EHL-TEMPLATE-001] Template %(name)s has no lines. Add lines to the template"
" first."
msgstr ""
"[EHL-TEMPLATE-001] У шаблона %(name)s нет строк. Сначала добавьте строки в "
"шаблон."
