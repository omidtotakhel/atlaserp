                        <group>
                            <field name="qty_on_hand"             readonly="1" string="On Hand"/>
                            <field name="qty_forecast"            readonly="1" string="Forecasted Qty"/>
                            <field name="orderpoint_qty_to_order" readonly="1" string="MPS To Order"/>
                            <field name="demand_qty"              readonly="1" string="Effective Demand"/>
                        </group>
                        <group>
                            <field name="po_qty_draft"    readonly="1" string="Draft PO Qty"/>
                            <field name="po_qty_confirmed" readonly="1" string="Confirmed PO Qty"/>
                            <field name="open_po_count"   readonly="1" string="Open POs (draft/sent)"/>
