    <!--
        MPS Vendor Demand Line – List / Form / Search views
        ====================================================
        Opened by the wizard's "View Lines" button (domain-filtered to the
        current session) and also accessible from the standalone menu entry
        "Vendor Demand Lines" (shows all lines across all sessions).
        All views are read-only; data is managed exclusively by the wizard.
    -->

    <!-- ── List (tree) view ───────────────────────────────────────── -->

    <record id="view_mps_vendor_demand_line_list" model="ir.ui.view">
        <field name="name">mps.vendor.demand.line.list</field>
        <field name="model">mps.vendor.demand.line</field>
        <field name="arch" type="xml">
            <tree string="MPS Vendor Demand"
                  create="false"
                  edit="false"
                  delete="false"
                  decoration-danger="uncovered_qty &gt; 0"
                  decoration-success="uncovered_qty &lt;= 0 and demand_qty &gt; 0"
                  decoration-muted="demand_qty &lt;= 0">

                <field name="vendor_id"              optional="show"  string="Vendor"/>
                <field name="product_id"             optional="show"  string="Product"/>
                <field name="vendor_product_code"    optional="show"  string="Vendor SKU"/>
                <field name="warehouse_id"           optional="show"  string="Warehouse"/>
                <field name="orderpoint_id"          optional="show"  string="Reorder Rule"/>
                <field name="vendor_lead_time"       optional="show"  string="Lead (d)"/>
                <field name="horizon_date"           optional="show"  string="Horizon"/>
                <field name="qty_on_hand"            optional="show"  string="On Hand"         digits="[16,2]"/>
                <field name="qty_forecast"           optional="show"  string="Forecast"         digits="[16,2]"/>
                <field name="vendor_min_qty"         optional="show"  string="Min Qty"          digits="[16,2]"/>
                <field name="orderpoint_qty_to_order" optional="show" string="MPS To Order"     digits="[16,2]"/>
                <field name="demand_qty"             optional="show"  string="Demand Qty"       digits="[16,2]"/>
                <field name="po_qty_draft"           optional="show"  string="Draft PO Qty"     digits="[16,2]"/>
                <field name="po_qty_confirmed"       optional="show"  string="Confirmed PO Qty" digits="[16,2]"/>
                <field name="open_po_count"          optional="show"  string="Open POs"/>
                <field name="uncovered_qty"          optional="show"  string="Uncovered Qty"    digits="[16,2]"/>
                <field name="vendor_price"           optional="hide"  string="Vendor Price"     digits="[16,4]"/>
                <field name="vendor_currency_id"     optional="hide"  string="Currency"/>
                <field name="vendor_sequence"        optional="hide"  string="Priority"/>
                <field name="product_uom_id"         optional="hide"  string="UoM"/>
                <field name="company_id"             optional="hide"  string="Company"/>

            </tree>
        </field>
    </record>

