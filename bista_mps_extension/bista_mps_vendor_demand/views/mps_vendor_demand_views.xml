        <field name="name">mps.vendor.demand.line.form</field>
        <field name="model">mps.vendor.demand.line</field>
        <field name="arch" type="xml">
            <form string="MPS Vendor Demand Line" create="false" edit="false">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="product_id" readonly="1"/>
                        </h1>
                        <h3 class="text-muted">
                            <field name="vendor_id" readonly="1" placeholder="No vendor assigned"/>
                        </h3>
                    </div>

