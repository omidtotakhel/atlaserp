                        <group>
                            <field name="product_id"          readonly="1"/>
                            <field name="product_uom_id"      readonly="1" string="Unit of Measure"/>
                            <field name="vendor_id"           readonly="1"/>
                            <field name="vendor_product_name" readonly="1" string="Vendor Description"/>
