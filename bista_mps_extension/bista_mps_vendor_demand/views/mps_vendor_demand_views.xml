    <!-- ── Search view ────────────────────────────────────────────── -->

    <record id="view_mps_vendor_demand_line_search" model="ir.ui.view">
        <field name="name">mps.vendor.demand.line.search</field>
        <field name="model">mps.vendor.demand.line</field>
        <field name="arch" type="xml">
            <search string="MPS Vendor Demand">

                <field name="vendor_id"          string="Vendor"
                       filter_domain="[('vendor_id', 'child_of', self)]"/>
                <field name="product_id"         string="Product"/>
                <field name="warehouse_id"       string="Warehouse"/>
                <field name="orderpoint_id"      string="Reorder Rule"/>
                <field name="vendor_product_code" string="Vendor SKU"/>

                <separator/>

                <filter name="filter_uncovered"
                        string="Uncovered"
                        domain="[('uncovered_qty', '&gt;', 0)]"/>
                <filter name="filter_no_vendor"
                        string="No Vendor"
                        domain="[('vendor_id', '=', False)]"/>
                <filter name="filter_has_draft_po"
                        string="Has Draft PO"
                        domain="[('po_qty_draft', '&gt;', 0)]"/>
                <filter name="filter_no_draft_po"
                        string="No Draft PO"
                        domain="[('po_qty_draft', '=', 0), ('demand_qty', '&gt;', 0)]"/>

                <separator/>

                <group expand="1" string="Group By">
                    <filter name="group_by_vendor"
                            string="Vendor"
                            context="{'group_by': 'vendor_id'}"/>
                    <filter name="group_by_product"
                            string="Product"
                            context="{'group_by': 'product_id'}"/>
                    <filter name="group_by_warehouse"
                            string="Warehouse"
                            context="{'group_by': 'warehouse_id'}"/>
                    <filter name="group_by_horizon"
                            string="Horizon Week"
                            context="{'group_by': 'horizon_date:week'}"/>
                    <filter name="group_by_company"
                            string="Company"
                            context="{'group_by': 'company_id'}"/>
                </group>

            </search>
        </field>
    </record>

    <!-- ── Standalone window action (for menu) ────────────────────── -->

    <record id="action_mps_vendor_demand_line_list" model="ir.actions.act_window">
        <field name="name">Vendor Demand Lines</field>
        <field name="res_model">mps.vendor.demand.line</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_mps_vendor_demand_line_search"/>
        <field name="context">{'search_default_group_by_vendor': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No vendor demand lines found.
            </p>
            <p>
                Use <strong>MPS Vendor Demand</strong> from the Operations menu
                to generate demand lines from your reordering rules and vendor
                pricelists.
            </p>
        </field>
    </record>

</odoo>