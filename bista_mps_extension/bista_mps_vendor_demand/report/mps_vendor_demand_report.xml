                                                        <t t-out="line.vendor_product_name"/>
                                                    </span>
                                                </t>
                                                <br/>
                                                <span class="text-muted" style="font-size:8pt;">
                                                    <t t-out="line.product_uom_id.name or ''"/>
                                                </span>
                                            </td>
                                            <td class="text-muted">
                                                <t t-out="line.vendor_product_code or '—'"/>
                                            </td>
                                            <td><t t-out="line.warehouse_id.name or '—'"/></td>
                                            <td><t t-out="line.orderpoint_id.name or '—'"/></td>
                                            <td class="text-end">
                                                <t t-out="line.vendor_lead_time or 0"/>
                                            </td>
                                            <td class="text-end">
                                                <t t-out="line.horizon_date and line.horizon_date.strftime('%d %b %Y') or '—'"/>
                                            </td>
                                            <td class="text-end">
                                                <t t-out="'{:,.2f}'.format(line.qty_on_hand or 0)"/>
                                            </td>
                                            <td class="text-end">
                                                <t t-out="'{:,.2f}'.format(line.qty_forecast or 0)"/>
                                            </td>
                                            <td class="text-end">
                                                <t t-out="'{:,.2f}'.format(line.orderpoint_qty_to_order or 0)"/>
                                            </td>
                                            <td class="text-end">
                                                <t t-out="'{:,.2f}'.format(line.vendor_min_qty or 0)"/>
                                            </td>
                                            <td class="text-end">
                                                <strong>
                                                    <t t-out="'{:,.2f}'.format(line.demand_qty or 0)"/>
                                                </strong>
                                            </td>
                                            <td class="text-end">
                                                <t t-out="'{:,.2f}'.format(line.po_qty_draft or 0)"/>
                                            </td>
                                            <td class="text-end">
                                                <t t-out="'{:,.2f}'.format(line.po_qty_confirmed or 0)"/>
                                            </td>
                                            <td class="text-end"
                                                t-attf-style="color: #{(line.uncovered_qty or 0) &gt; 0 and '#721c24' or '#155724'}; font-weight:600;">
                                                <t t-out="'{:,.2f}'.format(line.uncovered_qty or 0)"/>
                                            </td>
                                            <td class="text-center">
                                                <span t-attf-class="eh_pdf_status_badge #{line.get_coverage_css()}">
                                                    <t t-out="line.get_coverage_label()"/>
                                                </span>
                                            </td>
                                        </tr>
                                    </t>

                                    <!-- Vendor subtotal row -->
                                    <tr class="eh_pdf_section_total">
                                        <td colspan="10"
                                            class="text-end"
                                            style="font-size:8.5pt; font-style:italic;">
                                            Vendor Subtotal
                                        </td>
                                        <td class="text-end">
                                            <strong>
                                                <t t-out="'{:,.2f}'.format(grp_demand)"/>
                                            </strong>
                                        </td>
                                        <td class="text-end">
                                            <strong>
                                                <t t-out="'{:,.2f}'.format(grp_draft)"/>
                                            </strong>
                                        </td>
                                        <td class="text-end">—</td>
                                        <td class="text-end">
                                            <strong>
                                                <t t-out="'{:,.2f}'.format(grp_uncov)"/>
                                            </strong>
                                        </td>
                                        <td></td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>

                        <!-- ── Grand total ────────────────────────── -->
                        <table class="eh_pdf_table" style="margin-top:10pt;">
                            <tbody>
                                <tr class="eh_pdf_grand_total">
                                    <td colspan="10"
                                        class="text-end"
                                        style="font-size:9pt; font-weight:700;">
                                        Grand Total
                                    </td>
                                    <td class="text-end">
                                        <strong>
                                            <t t-out="'{:,.2f}'.format(total_demand)"/>
                                        </strong>
                                    </td>
                                    <td class="text-end">
                                        <strong>
                                            <t t-out="'{:,.2f}'.format(total_draft_po)"/>
                                        </strong>
                                    </td>
                                    <td class="text-end">
                                        <strong>
                                            <t t-out="'{:,.2f}'.format(total_confirmed)"/>
                                        </strong>
                                    </td>
                                    <td class="text-end">
                                        <strong>
                                            <t t-out="'{:,.2f}'.format(total_uncovered)"/>
                                        </strong>
                                    </td>
                                    <td></td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- ── ERP Heritage brand footer ─────────── -->
                        <t t-call="eh_log_base.eh_log_report_footer"/>

                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>