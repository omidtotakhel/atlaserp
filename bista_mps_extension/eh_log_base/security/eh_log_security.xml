<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="0">
    <data>

        <!--
            Privilege groups for the ERP Heritage logistics suite.

            Three groups under one privilege:

            * group_eh_log_user: read and operational access. Implies
              sales_team.group_sale_salesman so a logistics user can
              create and manage the underlying sale orders.
            * group_eh_log_manager: configuration, approval, override
              actions. Implies group_eh_log_user and
              sales_team.group_sale_manager.
            * group_eh_log_auditor: read-only on every audit log table.
              Stand-alone; deliberately does NOT imply group_eh_log_user
              so an auditor stays read-only.

            The post_init_hook seeds admin and existing salespeople into
            the new groups so a fresh install does not leave anyone
            locked out.
        -->

        <record id="privilege_eh_logistics" model="ir.module.category">
            <field name="name">ERP Heritage Logistics</field>
            <field name="sequence">95</field>
        </record>

        <record id="group_eh_log_user" model="res.groups">
            <field name="name">EH Logistics User</field>
            <field name="category_id" ref="privilege_eh_logistics"/>
            <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
            <field name="comment">Read and operational access to ERP Heritage logistics modules. Implies the standard Salesperson role.</field>
        </record>

        <record id="group_eh_log_manager" model="res.groups">
            <field name="name">EH Logistics Manager</field>
            <field name="category_id" ref="privilege_eh_logistics"/>
            <field name="implied_ids" eval="[(4, ref('eh_log_base.group_eh_log_user')), (4, ref('sales_team.group_sale_manager'))]"/>
            <field name="comment">Manager access to ERP Heritage logistics modules: configuration, approval, override actions. Implies the Logistics User role.</field>
        </record>

        <record id="group_eh_log_auditor" model="res.groups">
            <field name="name">EH Logistics Auditor (read-only)</field>
            <field name="category_id" ref="privilege_eh_logistics"/>
            <field name="comment">Read-only auditor: visibility on every ERP Heritage logistics audit log without write access. Cannot edit operational data.</field>
        </record>

        <!--
            Daily cron for event log retention.

            The base ships a default cron at 02:35 that prunes events
            older than the per-category retention window. Operators can
            disable the cron from Settings if they prefer to manage
            archival externally.
        -->

        <record id="ir_cron_eh_log_event_gc" model="ir.cron">
            <field name="name">EH Logistics: prune old operational events</field>
            <field name="model_id" ref="model_eh_log_event"/>
            <field name="state">code</field>
            <field name="code">model._gc_old_events()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
