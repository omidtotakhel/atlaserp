<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>

        <record id="view_eh_log_charge_code_list" model="ir.ui.view">
            <field name="name">eh.log.charge.code.list</field>
            <field name="model">eh.log.charge.code</field>
            <field name="arch" type="xml">
                <tree string="Charge Codes" multi_edit="0">
                    <field name="code"/>
                    <field name="name"/>
                    <field name="category"/>
                    <field name="mode"/>
                    <field name="direction"/>
                    <field name="is_disbursement" optional="show"/>
                    <field name="default_currency_id" optional="hide"/>
                    <field name="active" optional="hide"/>
                </tree>
            </field>
        </record>

        <record id="view_eh_log_charge_code_form" model="ir.ui.view">
            <field name="name">eh.log.charge.code.form</field>
            <field name="model">eh.log.charge.code</field>
            <field name="arch" type="xml">
                <form string="Charge Code">
                    <sheet>
                        <div class="oe_title">
                            <label for="code"/>
                            <h1>
                                <field name="code" placeholder="OFR"/>
                            </h1>
                            <field name="name" placeholder="Ocean Freight"/>
                        </div>
                        <group>
                            <group string="Classification">
                                <field name="category"/>
                                <field name="mode"/>
                                <field name="direction"/>
                                <field name="is_disbursement" widget="boolean_toggle"/>
                                <field name="is_taxable_at_destination"/>
                            </group>
                            <group string="Defaults">
                                <field name="default_currency_id"/>
                                <field name="default_revenue_account_id"/>
                                <field name="default_expense_account_id"/>
                                <field name="active" widget="boolean_toggle"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Detail">
                                <field name="description"/>
                            </page>
                            <page string="Companies">
                                <field name="company_ids" widget="many2many_tags"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_eh_log_charge_code_search" model="ir.ui.view">
            <field name="name">eh.log.charge.code.search</field>
            <field name="model">eh.log.charge.code</field>
            <field name="arch" type="xml">
                <search>
                    <field name="code"/>
                    <field name="name"/>
                    <separator/>
                    <filter string="Disbursement" name="filter_disbursement" domain="[('is_disbursement', '=', True)]"/>
                    <filter string="Active" name="filter_active" domain="[('active', '=', True)]"/>
                    <filter string="Inactive" name="filter_inactive" domain="[('active', '=', False)]"/>
                    <filter string="Group by Category" name="group_category" context="{'group_by': 'category'}"/>
                    <filter string="Group by Mode" name="group_mode" context="{'group_by': 'mode'}"/>
                </search>
            </field>
        </record>

        <record id="action_eh_log_charge_code" model="ir.actions.act_window">
            <field name="name">Charge Codes</field>
            <field name="res_model">eh.log.charge.code</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_eh_log_charge_code_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Define your charge code catalogue
                </p>
                <p>
                    A starter set of universally recognised codes is seeded
                    on install. Add country or contract specific codes here.
                </p>
            </field>
        </record>

    </data>
</odoo>
