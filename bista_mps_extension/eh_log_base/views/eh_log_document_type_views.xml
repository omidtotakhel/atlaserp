<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>

        <record id="view_eh_log_document_type_list" model="ir.ui.view">
            <field name="name">eh.log.document.type.list</field>
            <field name="model">eh.log.document.type</field>
            <field name="arch" type="xml">
                <tree string="Document Types">
                    <field name="code"/>
                    <field name="name"/>
                    <field name="category"/>
                    <field name="is_required_default" optional="show"/>
                    <field name="expiry_aware" optional="show"/>
                    <field name="expiry_warning_days" optional="hide"/>
                    <field name="applies_to_modes" optional="hide"/>
                </tree>
            </field>
        </record>

        <record id="view_eh_log_document_type_form" model="ir.ui.view">
            <field name="name">eh.log.document.type.form</field>
            <field name="model">eh.log.document.type</field>
            <field name="arch" type="xml">
                <form string="Document Type">
                    <sheet>
                        <div class="oe_title">
                            <label for="code"/>
                            <h1>
                                <field name="code" placeholder="HBL"/>
                            </h1>
                            <field name="name" placeholder="House Bill of Lading"/>
                        </div>
                        <group>
                            <group string="Behaviour">
                                <field name="category"/>
                                <field name="is_required_default"/>
                                <field name="applies_to_modes"/>
                            </group>
                            <group string="Expiry Tracking">
                                <field name="expiry_aware"/>
                                <field name="expiry_warning_days" attrs="{'invisible': [('expiry_aware', '=', False)]}"/>
                                <field name="active" widget="boolean_toggle"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Detail">
                                <field name="description"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_eh_log_document_type_search" model="ir.ui.view">
            <field name="name">eh.log.document.type.search</field>
            <field name="model">eh.log.document.type</field>
            <field name="arch" type="xml">
                <search>
                    <field name="code"/>
                    <field name="name"/>
                    <filter string="Required by Default" name="filter_required" domain="[('is_required_default', '=', True)]"/>
                    <filter string="Tracks Expiry" name="filter_expiry" domain="[('expiry_aware', '=', True)]"/>
                    <filter string="Active" name="filter_active" domain="[('active', '=', True)]"/>
                    <filter string="Group by Category" name="group_category" context="{'group_by': 'category'}"/>
                </search>
            </field>
        </record>

        <record id="action_eh_log_document_type" model="ir.actions.act_window">
            <field name="name">Document Types</field>
            <field name="res_model">eh.log.document.type</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_eh_log_document_type_search"/>
        </record>

    </data>
</odoo>
