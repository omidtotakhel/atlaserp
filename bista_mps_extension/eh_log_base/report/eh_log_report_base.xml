<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!--
        Shared QWeb scaffolding for ERP Heritage logistics reports.

        Mirrors the eh_account_base.eh_report_styles shape so the two
        product lines look identical when both are installed and a
        single customer prints from either suite. The brand string in
        header / footer reads "ERP Heritage Logistics" instead of
        "ERP Heritage Accounting Suite".

        Per-vertical modules include this stylesheet via t-call so the
        visual identity stays consistent without each addon shipping its
        own CSS.
    -->

    <template id="eh_log_report_styles">
        <style type="text/css">
            .eh_pdf_page {
                font-family: "DM Sans", "Helvetica Neue", Arial, sans-serif;
                font-size: 10.5pt;
                color: #2c3e50;
                line-height: 1.45;
            }
            .eh_pdf_title {
                font-size: 22pt;
                font-weight: 700;
                color: #1a2332;
                margin: 0 0 4pt 0;
                letter-spacing: -0.01em;
            }
            .eh_pdf_subtitle {
                font-size: 12pt;
                font-weight: 700;
                color: #1a2332;
                margin: 16pt 0 6pt 0;
                letter-spacing: 0.01em;
            }
            .eh_pdf_meta {
                font-size: 9.5pt;
                color: #495057;
                margin-bottom: 14pt;
                line-height: 1.6;
            }
            .eh_pdf_meta strong { color: #1a2332; font-weight: 600; }
            .eh_pdf_meta span { margin-right: 14pt; }

            .eh_pdf_table {
                width: 100%;
                border-collapse: collapse;
                font-size: 10pt;
            }
            .eh_pdf_table thead th {
                background: #1a2332;
                color: #fdf6e3;
                border-bottom: 1.5pt solid #C9A372;
                padding: 7pt 9pt;
                font-weight: 700;
                text-align: left;
                font-size: 8.5pt;
                text-transform: uppercase;
                letter-spacing: 0.06em;
            }
            .eh_pdf_table tbody td {
                padding: 7pt 9pt;
                border-bottom: 0.4pt solid #e6e0d4;
                font-size: 10pt;
                vertical-align: top;
            }
            .eh_pdf_table tbody tr:nth-child(even) td {
                background: #faf6ee;
            }
            .eh_pdf_table .text-end { text-align: right; }
            .eh_pdf_table .text-center { text-align: center; }
            .eh_pdf_table .text-muted { color: #6c757d; }

            .eh_pdf_table tr.eh_pdf_section_header td {
                background: #e9ecef;
                font-weight: 700;
                font-size: 9.5pt;
                border-top: 1pt solid #495057;
            }
            .eh_pdf_table tr.eh_pdf_section_total td {
                background: #f1f3f5;
                font-weight: 700;
                border-top: 1pt solid #495057;
            }
            .eh_pdf_table tr.eh_pdf_grand_total td {
                background: #fff3cd;
                font-weight: 700;
                border-top: 1.5pt solid #ffc107;
                border-bottom: 1.5pt solid #ffc107;
            }

            .eh_pdf_summary_box {
                border: 0.5pt solid #adb5bd;
                background: #fafbfc;
                padding: 8pt 10pt;
                margin-bottom: 10pt;
                font-size: 9pt;
            }
            .eh_pdf_summary_box .label {
                color: #6c757d;
                text-transform: uppercase;
                font-size: 7.5pt;
                letter-spacing: 0.04em;
                margin-bottom: 1pt;
            }
            .eh_pdf_summary_box .value {
                font-size: 10pt;
                font-weight: 600;
                color: #2c3e50;
            }

            .eh_pdf_signature_block {
                margin-top: 28pt;
                font-size: 8.5pt;
                color: #495057;
            }
            .eh_pdf_signature_line {
                border-top: 0.5pt solid #495057;
                width: 50%;
                margin-top: 18pt;
                padding-top: 4pt;
                font-size: 8pt;
                color: #6c757d;
            }

            .eh_pdf_status_badge {
                display: inline-block;
                padding: 1pt 6pt;
                border-radius: 8pt;
                font-size: 7.5pt;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.04em;
            }
            .eh_pdf_status_ok      { background: #d4edda; color: #155724; }
            .eh_pdf_status_warn    { background: #fff3cd; color: #856404; }
            .eh_pdf_status_danger  { background: #f8d7da; color: #721c24; }
            .eh_pdf_status_info    { background: #d1ecf1; color: #0c5460; }
            .eh_pdf_status_neutral { background: #e2e3e5; color: #383d41; }

            .eh_pdf_footer {
                margin-top: 22pt;
                padding-top: 8pt;
                border-top: 0.5pt solid #C9A372;
                text-align: center;
                letter-spacing: 0.04em;
            }
            .eh_pdf_footer_brand {
                font-size: 8pt;
                color: #495057;
                font-weight: 700;
                letter-spacing: 0.08em;
                text-transform: uppercase;
                margin-bottom: 2pt;
            }
            .eh_pdf_footer_credit {
                font-size: 7.5pt;
                color: #6c757d;
                font-style: italic;
                letter-spacing: 0.02em;
            }
            .eh_pdf_heart {
                color: #C9A372;
                font-size: 9pt;
                padding: 0 2pt;
                font-family: "DejaVu Sans", "Liberation Sans", Arial, sans-serif;
            }
            .eh_pdf_header {
                margin: 0 0 18pt 0;
                padding: 0 0 14pt 0;
                border-bottom: 1pt solid #C9A372;
            }
            .eh_pdf_header_brand {
                font-size: 8pt;
                font-weight: 700;
                letter-spacing: 0.16em;
                color: #C9A372;
                text-transform: uppercase;
                margin-bottom: 4pt;
            }
            .eh_pdf_header_company {
                font-size: 9pt;
                color: #6c757d;
                margin-top: 4pt;
            }
        </style>
    </template>

    <template id="eh_log_report_footer">
        <!--
            Brand-attribution footer.

            The credit line is rendered at runtime through the
            integrity-verified eh.log.brand model. The model raises
            BrandIntegrityError if the brand chunks have been
            tampered with; the report render aborts before any
            output is produced. Editing the literal between the
            spans here does NOT bypass the check because the text
            is replaced at render with the integrity-verified
            string.

            Removing this template entirely is detected by every
            per-vertical report (which t-call this template) and
            by the dashboard tile (which calls brand_html on the
            same model).
        -->
        <div class="eh_pdf_footer">
            <div class="eh_pdf_footer_brand">ERP Heritage Logistics</div>
            <div class="eh_pdf_footer_credit">
                <t t-out="env['eh.log.brand'].brand_line()"/>
            </div>
        </div>
    </template>

    <template id="eh_log_report_header">
        <div class="eh_pdf_header">
            <div class="eh_pdf_header_brand">ERP Heritage Logistics</div>
            <h1 class="eh_pdf_title" t-out="title"/>
            <div class="eh_pdf_header_company"
                 t-if="company">
                <t t-out="company.display_name"/>
                <span t-if="company.country_id"> / <t t-out="company.country_id.name"/></span>
            </div>
        </div>
    </template>

    <template id="eh_log_clean_layout">
        <!--
            Universal report shell wrapped around every PDF in the
            suite. The footer renders the integrity-verified brand
            line on every page; if the chunk fragments have been
            tampered with, the brand-line call raises and the PDF
            never reaches the operator.
        -->
        <div t-attf-class="footer o_company_#{company.id if company else 'na'}_layout">
            <div class="o_footer_content d-flex border-top pt-2"
                 style="font-size: 7.5pt; color: #6c757d; padding-top: 4pt;">
                <div class="flex-grow-1 text-start me-2">
                    <t t-out="env['eh.log.brand'].brand_line()"/>
                </div>
                <div class="text-end text-muted text-nowrap"
                     t-if="report_type == 'pdf'">
                    Page <span class="page"/> / <span class="topage"/>
                </div>
            </div>
        </div>
        <div class="article o_report_layout_standard">
            <t t-out="0"/>
        </div>
    </template>

</odoo>
