<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">

        <!--
            Reference number sequences shared by the logistics suite.

            Per-vertical modules add their own sequences (forwarding
            job, customs declaration, transport order, etc.). The base
            ships sequences that need to exist before any vertical is
            installed: the correlation-id-friendly job reference and
            the operational event grouping reference.

            Convention: per-company variants are defined by per-vertical
            modules using ir.sequence.date_range and company_id; the
            base sequences are global so the eh.log.event log stays
            cross-company readable for auditors.
        -->

        <record id="seq_eh_log_event_group" model="ir.sequence">
            <field name="name">EH Logistics Event Group</field>
            <field name="code">eh.log.event.group</field>
            <field name="prefix">EVT/%(year)s/</field>
            <field name="padding">7</field>
            <field name="number_increment">1</field>
            <field name="implementation">no_gap</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_eh_log_correlation" model="ir.sequence">
            <field name="name">EH Logistics Correlation Reference</field>
            <field name="code">eh.log.correlation</field>
            <field name="prefix">COR-%(year)s%(month)s%(day)s-</field>
            <field name="padding">6</field>
            <field name="number_increment">1</field>
            <field name="implementation">no_gap</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
