<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">

        <!--
            Default ir.config_parameter values for the logistics suite.

            Every system-wide tunable read by the suite ships with a
            default here so a fresh install does not require a tour
            of the Settings UI before the first quotation.

            Operators override via Settings > ERP Heritage Logistics or
            via the standard Configuration > Technical > System
            Parameters screen for the technical fields not exposed in
            the simplified Settings UI.
        -->

        <record id="param_adapter_message_payload_max_chars" model="ir.config_parameter">
            <field name="key">eh_log.base.adapter_message_payload_max_chars</field>
            <field name="value">32768</field>
        </record>

        <record id="param_event_retention_state_transition" model="ir.config_parameter">
            <field name="key">eh_log.base.event_retention_days.state_transition</field>
            <field name="value">365</field>
        </record>

        <record id="param_event_retention_override" model="ir.config_parameter">
            <field name="key">eh_log.base.event_retention_days.override</field>
            <field name="value">2555</field>
        </record>

        <record id="param_event_retention_adapter_call" model="ir.config_parameter">
            <field name="key">eh_log.base.event_retention_days.adapter_call</field>
            <field name="value">180</field>
        </record>

        <record id="param_event_retention_config_change" model="ir.config_parameter">
            <field name="key">eh_log.base.event_retention_days.config_change</field>
            <field name="value">2555</field>
        </record>

        <record id="param_event_retention_approval" model="ir.config_parameter">
            <field name="key">eh_log.base.event_retention_days.approval</field>
            <field name="value">2555</field>
        </record>

        <record id="param_event_retention_audit_note" model="ir.config_parameter">
            <field name="key">eh_log.base.event_retention_days.audit_note</field>
            <field name="value">365</field>
        </record>

    </data>
</odoo>
