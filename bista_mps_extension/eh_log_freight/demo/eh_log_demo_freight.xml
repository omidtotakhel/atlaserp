<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">

        <!-- Reusable demo product for freight order lines -->
        <record id="demo_product_freight_service" model="product.product">
            <field name="name">Freight Forwarding Service (Demo)</field>
            <field name="type">service</field>
            <field name="sale_ok" eval="True"/>
            <field name="purchase_ok" eval="False"/>
            <field name="list_price">2500.0</field>
        </record>

        <!-- Sale orders backing freight jobs (will be confirmed via function below) -->

        <record id="demo_so_freight_001" model="sale.order">
            <field name="partner_id" ref="eh_log_base.demo_partner_alpha_trading"/>
            <field name="eh_log_is_logistics" eval="True"/>
            <field name="eh_log_mode">sea</field>
            <field name="eh_log_direction">import</field>
            <field name="eh_log_origin_country_id" ref="base.cn"/>
            <field name="eh_log_destination_country_id" ref="base.ae"/>
            <field name="eh_log_origin_location">Shanghai (CNSHA)</field>
            <field name="eh_log_destination_location">Jebel Ali (AEJEA)</field>
            <field name="client_order_ref">AT-FCL-2026-101</field>
            <field name="order_line" eval="[(0, 0, {'product_id': ref('demo_product_freight_service'), 'name': 'Sea import 40HC SHA-AUH', 'product_uom_qty': 1, 'price_unit': 3200})]"/>
        </record>

