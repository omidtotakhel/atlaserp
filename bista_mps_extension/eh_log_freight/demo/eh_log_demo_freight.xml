        <!-- Confirm 8 orders so freight jobs get spawned through the normal flow.
             demo_so_freight_009..012 stay as draft to swell the dashboard "Open Quotations" tile. -->

        <function model="sale.order" name="action_confirm"
                 eval="[[ref('demo_so_freight_001'),
                         ref('demo_so_freight_002'),
                         ref('demo_so_freight_003'),
                         ref('demo_so_freight_004'),
                         ref('demo_so_freight_005'),
                         ref('demo_so_freight_006'),
