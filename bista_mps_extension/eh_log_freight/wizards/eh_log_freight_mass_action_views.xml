<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_eh_log_freight_mass_advance_form" model="ir.ui.view">
        <field name="name">eh.log.freight.mass.advance.form</field>
        <field name="model">eh.log.freight.mass.advance</field>
        <field name="arch" type="xml">
            <form string="Mass-advance Freight Jobs">
                <group>
                    <field name="job_ids" widget="many2many_tags" readonly="1"/>
                    <field name="target_state"/>
                </group>
                <footer>
                    <button name="action_apply" type="object"
                            string="Advance" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_eh_log_freight_mass_advance" model="ir.actions.act_window">
        <field name="name">Mass-advance State</field>
        <field name="res_model">eh.log.freight.mass.advance</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_eh_log_freight_job"/>
        <field name="binding_view_types">list</field>
    </record>

</odoo>
