<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">

        <record id="seq_eh_log_freight_job" model="ir.sequence">
            <field name="name">Freight Forwarding Job</field>
            <field name="code">eh.log.freight.job</field>
            <field name="prefix">FF/%(year)s/</field>
            <field name="padding">6</field>
            <field name="number_increment">1</field>
            <field name="implementation">no_gap</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_eh_log_freight_bl" model="ir.sequence">
            <field name="name">Bill of Lading</field>
            <field name="code">eh.log.freight.bl</field>
            <field name="prefix">BL/%(year)s/</field>
            <field name="padding">6</field>
            <field name="number_increment">1</field>
            <field name="implementation">no_gap</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
