<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>

        <record id="view_eh_log_freight_bl_list" model="ir.ui.view">
            <field name="name">eh.log.freight.bl.list</field>
            <field name="model">eh.log.freight.bl</field>
            <field name="arch" type="xml">
                <tree string="Bills of Lading" decoration-info="state == 'draft'" decoration-success="state in ('issued', 'released', 'closed')" decoration-muted="state == 'cancelled'">
                    <field name="name"/>
                    <field name="bl_type"/>
                    <field name="number"/>
                    <field name="state"/>
                    <field name="job_id"/>
                    <field name="shipper_id" optional="show"/>
                    <field name="consignee_id" optional="show"/>
                    <field name="carrier_id" optional="show"/>
                    <field name="vessel_name" optional="hide"/>
                    <field name="flight_number" optional="hide"/>
                    <field name="issue_date"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </tree>
            </field>
        </record>

        <record id="view_eh_log_freight_bl_form" model="ir.ui.view">
            <field name="name">eh.log.freight.bl.form</field>
            <field name="model">eh.log.freight.bl</field>
            <field name="arch" type="xml">
                <form string="Bill of Lading">
                    <header>
                        <button name="action_issue" string="Issue" type="object" class="btn-primary" groups="eh_log_base.group_eh_log_user" attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                        <button name="action_release" string="Release" type="object" class="btn-primary" groups="eh_log_base.group_eh_log_user" attrs="{'invisible': [('state', '!=', 'issued')]}"/>
                        <button name="action_close" string="Close" type="object" class="btn-primary" groups="eh_log_base.group_eh_log_manager" attrs="{'invisible': [('state', '!=', 'released')]}"/>
                        <button name="action_cancel" string="Cancel" type="object" class="btn-secondary" groups="eh_log_base.group_eh_log_manager" attrs="{'invisible': [('state', 'in', ['closed', 'cancelled'])]}"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1><field name="name"/></h1>
                            <h3>
                                <field name="bl_type"/> <field name="number" placeholder="BL Number"/>
                            </h3>
                        </div>
                        <group>
                            <group string="Document">
                                <field name="job_id" options="{'no_create': True}" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                <field name="bl_type" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                <field name="issue_date"/>
                                <field name="onboard_date"/>
                                <field name="release_type"/>
                                <field name="freight_payment_terms"/>
                                <field name="incoterm_id"/>
                            </group>
                            <group string="Carrier">
                                <field name="carrier_id" options="{'no_create': True}"/>
                                <field name="vessel_name" attrs="{'invisible': [('bl_type', 'not in', ['hbl', 'mbl'])]}"/>
                                <field name="voyage_number" attrs="{'invisible': [('bl_type', 'not in', ['hbl', 'mbl'])]}"/>
                                <field name="flight_number" attrs="{'invisible': [('bl_type', 'not in', ['hawb', 'mawb'])]}"/>
                            </group>
                        </group>
                        <group>
                            <group string="Parties">
                                <field name="shipper_id" options="{'no_create': True}"/>
                                <field name="consignee_id" options="{'no_create': True}"/>
                                <field name="notify_party_id" options="{'no_create': True}"/>
                            </group>
                            <group string="Lane">
                                <field name="place_of_receipt"/>
                                <field name="pol_name"/>
                                <field name="pod_name"/>
                                <field name="place_of_delivery"/>
                            </group>
                        </group>
                        <group string="Cargo">
                            <group>
                                <field name="cargo_description" colspan="2"/>
                                <field name="package_count"/>
                            </group>
                            <group>
                                <field name="gross_weight_kg"/>
                                <field name="volume_cbm"/>
                                <field name="chargeable_weight_kg" attrs="{'invisible': [('bl_type', 'not in', ['hawb', 'mawb'])]}"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Containers" attrs="{'invisible': [('bl_type', 'not in', ['hbl', 'mbl'])]}">
                                <field name="container_ids">
                                    <tree>
                                        <field name="container_number"/>
                                        <field name="iso_type_id"/>
                                        <field name="seal_number"/>
                                        <field name="gross_weight_kg"/>
                                        <field name="state"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Consolidation" attrs="{'invisible': [('bl_type', 'not in', ['hbl', 'hawb'])]}">
                                <group>
                                    <field name="parent_bl_id" options="{'no_create': True}"/>
                                </group>
                            </page>
                            <page string="House BLs" attrs="{'invisible': [('bl_type', 'not in', ['mbl', 'mawb'])]}">
                                <field name="child_bl_ids">
                                    <tree>
                                        <field name="name"/>
                                        <field name="number"/>
                                        <field name="bl_type"/>
                                        <field name="state"/>
                                        <field name="shipper_id"/>
                                        <field name="consignee_id"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_eh_log_freight_bl_search" model="ir.ui.view">
            <field name="name">eh.log.freight.bl.search</field>
            <field name="model">eh.log.freight.bl</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="number"/>
                    <field name="job_id"/>
                    <field name="shipper_id"/>
                    <field name="consignee_id"/>
                    <separator/>
                    <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                    <filter string="Issued" name="filter_issued" domain="[('state', '=', 'issued')]"/>
                    <filter string="Released" name="filter_released" domain="[('state', '=', 'released')]"/>
                    <separator/>
                    <filter string="HBL" name="filter_hbl" domain="[('bl_type', '=', 'hbl')]"/>
                    <filter string="MBL" name="filter_mbl" domain="[('bl_type', '=', 'mbl')]"/>
                    <filter string="HAWB" name="filter_hawb" domain="[('bl_type', '=', 'hawb')]"/>
                    <filter string="MAWB" name="filter_mawb" domain="[('bl_type', '=', 'mawb')]"/>
                    <filter string="Group by State" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Group by Type" name="group_bl_type" context="{'group_by': 'bl_type'}"/>
                </search>
            </field>
        </record>

        <record id="action_eh_log_freight_bl" model="ir.actions.act_window">
            <field name="name">Bills of Lading</field>
            <field name="res_model">eh.log.freight.bl</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_eh_log_freight_bl_search"/>
        </record>

    </data>
</odoo>
