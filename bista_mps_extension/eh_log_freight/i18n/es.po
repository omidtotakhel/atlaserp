#, python-format
msgid ""
"[EHL-BL-001] %(name)s cannot be issued without a BL number. Capture the "
"carrier-issued number first."
msgstr ""
"[EHL-BL-001] %(name)s no puede emitirse sin un número de BL. Registre "
"primero el número emitido por el transportista."

#. module: eh_log_freight
#. odoo-python
#: code:addons/eh_log_freight/models/eh_log_freight_bl.py:0
msgid ""
"[EHL-BL-002] State changes on a bill of lading must go through the action "
"buttons. Direct writes are rejected."
msgstr ""
"[EHL-BL-002] Los cambios de estado en un conocimiento de embarque deben "
"realizarse mediante los botones de acción. Las escrituras directas se "
"rechazan."

#. module: eh_log_freight
#. odoo-python
#: code:addons/eh_log_freight/models/eh_log_freight_job.py:0
msgid ""
"[EHL-JOB-STATE-002] State changes on a freight job must go through the "
"action buttons (Book, Set In Transit, Deliver, Close, Cancel). Direct writes"
" are rejected."
msgstr ""
"[EHL-JOB-STATE-002] Los cambios de estado en un trabajo de flete deben "
"realizarse mediante los botones de acción (Book, Set In Transit, Deliver, "
"Close, Cancel). Las escrituras directas se rechazan."

