#: model:ir.model.fields,help:eh_log_freight.field_eh_log_freight_milestone_type__is_terminal
msgid ""
"When checked, recording an actual datetime for this milestone advances the "
"job into its terminal closed state."
msgstr "勾选后，为此里程碑记录实际日期时间会将作业推进至其最终关闭状态。"

#. module: eh_log_freight
#: model:ir.model.fields,help:eh_log_freight.field_eh_log_freight_milestone_type__is_required
msgid ""
"When checked, the milestone is auto-added to every job timeline matching the"
" mode."
msgstr "勾选后，该里程碑会自动添加到与该模式匹配的每个作业时间线中。"

#. module: eh_log_freight
#. odoo-python
#: code:addons/eh_log_freight/models/eh_log_freight_bl.py:0
#, python-format
msgid ""
"[EHL-BL-001] %(name)s cannot be issued without a BL number. Capture the "
"carrier-issued number first."
msgstr "[EHL-BL-001] 没有 BL 编号,无法签发 %(name)s。请先录入承运人签发的编号。"

#. module: eh_log_freight
#. odoo-python
#: code:addons/eh_log_freight/models/eh_log_freight_bl.py:0
msgid ""
"[EHL-BL-002] State changes on a bill of lading must go through the action "
"buttons. Direct writes are rejected."
msgstr "[EHL-BL-002] 提单的状态更改必须通过操作按钮进行。直接写入将被拒绝。"

#. module: eh_log_freight
#. odoo-python
#: code:addons/eh_log_freight/models/eh_log_freight_job.py:0
msgid ""
"[EHL-JOB-STATE-002] State changes on a freight job must go through the "
"action buttons (Book, Set In Transit, Deliver, Close, Cancel). Direct writes"
" are rejected."
msgstr ""
"[EHL-JOB-STATE-002] 货运任务的状态变更必须通过操作按钮进行（Book、Set In "
"Transit、Deliver、Close、Cancel）。直接写入会被拒绝。"

